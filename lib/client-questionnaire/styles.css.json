"*{box-sizing:border-box}body{margin:0;background:#f5f7fa;color:#203247;font:16px/1.6 -apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif}button,input,textarea{font:inherit}button,.button{cursor:pointer;display:inline-flex;justify-content:center;align-items:center;min-height:44px;border:1px solid #c6d3e1;border-radius:7px;padding:10px 17px;color:#203247;background:white;text-decoration:none;font-size:14px;font-weight:600}button:disabled{opacity:.6;cursor:wait}button.primary,.button.primary{background:#246bb3;color:white;border-color:#246bb3}a{color:#246bb3}a:focus-visible,button:focus-visible,input:focus-visible,textarea:focus-visible{outline:3px solid #3189df;outline-offset:3px}[hidden]{display:none!important}.wrap{width:min(100% - 48px,980px);margin:auto}.mast{display:flex;justify-content:space-between;align-items:center;padding:26px 0;border-bottom:1px solid #d5dee8;gap:16px}.brand{color:#17334e;font-size:22px;font-weight:800;letter-spacing:4px;text-decoration:none;line-height:1.2}.brand span{display:block;font-size:9px;letter-spacing:6px;margin-top:5px}.pill{font-size:10px;letter-spacing:1.5px;color:#456985}.hero{padding:48px 0 28px;max-width:720px}.eyebrow{font-size:11px;letter-spacing:1.6px;font-weight:750;color:#246bb3;margin:0 0 12px}h1{font-size:clamp(36px,5.5vw,56px);line-height:1.06;letter-spacing:-2px;margin:0 0 22px}h2{font-size:27px;line-height:1.25;letter-spacing:-.7px;margin:0 0 12px}h3{font-size:19px;line-height:1.35}h4{font-size:14px;margin:22px 0 5px}.lead{font-size:18px;line-height:1.6;max-width:650px}.muted{color:#5e7185;font-size:14px}.progress-row{display:flex;justify-content:space-between;gap:12px;font-size:12px;font-weight:650;color:#3a5b78}progress{appearance:none;display:block;width:100%;height:5px;margin:10px 0 18px;border:0;background:#dce6f0;border-radius:3px}progress::-webkit-progress-bar{background:#dce6f0}progress::-webkit-progress-value{background:#246bb3}progress::-moz-progress-bar{background:#246bb3}.steps{display:flex;gap:8px;flex-wrap:wrap}.steps button{font-size:12px;padding:8px 11px;background:transparent;border-color:transparent}.steps button[aria-current]{background:#e0ecf7;border-color:#a8c5e0;color:#174e83}.card{background:white;border:1px solid #dbe3ec;border-radius:12px;padding:32px;margin:22px 0}.field{display:block;margin:26px 0;font-size:15px;font-weight:650}.field input,.field textarea{display:block;width:100%;border:1px solid #bacbdb;background:#fbfcfe;border-radius:6px;min-height:48px;padding:12px;color:#203247;margin-top:9px;font-weight:400;resize:vertical}.field small{display:block;color:#61758a;font-size:13px;font-weight:400;margin-top:8px}.formgrid{display:grid;grid-template-columns:1fr 1fr;gap:0 22px}.formgrid .field{margin:12px 0}.actions{display:flex;justify-content:space-between;gap:16px}.actions .primary{margin-left:auto;min-width:180px}.toolbar{display:flex;gap:10px;flex-wrap:wrap}.draftbar{display:flex;align-items:center;justify-content:space-between;gap:26px;border-top:1px solid #d5dee8;margin-top:32px;padding:20px 0;color:#61758a;font-size:12px}.draftbar p{max-width:430px}.draftbar button{font-size:12px;background:transparent;padding:8px 12px}.footer{padding:35px 0;color:#4c6780;font-size:10px;letter-spacing:1.4px}.footer span{display:block;letter-spacing:0;margin-top:6px;font-size:12px}.review-section{border-top:1px solid #e2e8ef;padding:18px 0;overflow-wrap:anywhere}.review-section button{font-size:12px}.answer{white-space:pre-wrap;overflow-wrap:anywhere}.consent{display:flex;align-items:flex-start;gap:12px;font-size:14px;border-top:1px solid #d5dee8;padding-top:24px}.consent input{width:20px;height:20px;flex-shrink:0;margin-top:3px}.error{padding:14px 18px;background:#fff1ee;border:1px solid #d49a88;border-radius:8px;color:#8c3220}.trap{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}.records{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.record{text-align:left;display:block;overflow-wrap:anywhere;padding:20px}.record strong,.record small{display:block}.record small{font-weight:400;color:#61758a;margin-top:6px}.share{padding:20px;border-left:3px solid #246bb3;background:#e9f1f8;overflow-wrap:anywhere}.share input{width:100%;margin:10px 0;padding:10px;border:1px solid #b9cee0;font-size:14px}#receipt{overflow-wrap:anywhere}@media(max-width:600px){.wrap{width:calc(100% - 32px)}.mast{padding:20px 0}.pill{font-size:8px;letter-spacing:.7px}.hero{padding:34px 0 22px}h1{letter-spacing:-1.3px}.lead{font-size:16px}.card{padding:22px 18px}.formgrid,.records{grid-template-columns:1fr}.draftbar{display:block}.steps{gap:3px}.steps button{font-size:11px;padding:7px}.actions .primary{min-width:150px}.field{font-size:14px}.field input,.field textarea{font-size:16px}h2{font-size:24px}}\n@media print{.mast,.hero,.toolbar,.share,.actions,.steps,.draftbar,.footer,button{display:none!important}.wrap{width:100%}.card{border:0;padding:0}body{background:white}.review-section{break-inside:avoid}}\n\n/* Questionnaire choices and stable, inline material details. */\n.hero{padding:22px 0 14px;max-width:760px}h1{font-size:clamp(28px,4vw,38px);line-height:1.15;letter-spacing:-1px;margin-bottom:10px}.hero .eyebrow{margin-bottom:8px}.lead{font-size:16px;margin:8px 0}.hero>.muted{margin:8px 0}.mast{padding:18px 0}.card{padding:24px;margin:16px 0}.choice-field{border:0;padding:0;margin:22px 0;min-width:0}.choice-field legend{font-size:16px;font-weight:650;line-height:1.4;padding:0}.choice-field>.muted{margin:6px 0 12px}.choice-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));align-items:start;gap:8px}.choice{display:flex;align-items:center;gap:9px;padding:10px 12px;min-height:44px;background:#fbfcfe;border:1px solid #c5d3e2;border-radius:7px;cursor:pointer;font-size:14px;line-height:1.4;max-width:100%}.choice:hover{border-color:#6c9c88}.choice:has(input:checked){border-color:#418b75;background:#eef8f3;color:#205b49}.choice input{width:18px;height:18px;flex-shrink:0;margin:0;accent-color:#29836d}.choice-with-followup{min-width:0}.choice-with-followup.expanded{grid-column:1/-1}.subchoices{padding:4px 12px 12px;margin-top:6px;border-left:2px solid #dce6f0}.followup{border:0;padding:0;margin:12px 0;min-width:0}.followup legend{font-size:14px;font-weight:600;line-height:1.4;margin:0 0 4px}.followup>small{display:block;font-size:12px;margin-bottom:6px}.subchoices .choice-grid{display:flex;flex-wrap:wrap;gap:4px 12px}.subchoices .choice,.subchoices .choice:has(input:checked){border:0;background:transparent;border-radius:0;padding:6px 0;min-height:40px;gap:7px;font-size:14px;line-height:1.4;color:#203247}.subchoices .choice:has(input:checked){color:#23735e}.subchoices .field{margin:6px 0;font-size:14px}.subchoices .field textarea{min-height:54px;margin-top:5px}.answered-row{display:flex;align-items:center;flex-wrap:wrap;gap:4px 10px;padding:8px 0;border-bottom:1px solid #e4eaf0;font-size:14px;line-height:1.4}.answered-question{font-weight:600}.picker-value{color:#23735e;overflow-wrap:anywhere}.answer-edit{padding:6px 8px;min-height:36px;font-size:13px;background:transparent;border:0;color:#246bb3;text-decoration:underline}.answered-row .answer-edit{margin-left:auto}.material-done{font-size:13px;margin-top:6px;min-height:40px}.services-notice{font-size:14px;padding:10px 12px;border-left:3px solid #29836d;background:#f0f8f5}.plan-recap{margin:12px 0;overflow-wrap:anywhere}.plan-recap h3{margin:0 0 12px;font-size:19px}.plan-recap p{font-size:14px;margin:6px 0}.recap-material{padding:10px 0;border-bottom:1px solid #e1e9e5}.full-answers{font-size:14px;margin:18px 0}.full-answers>summary{cursor:pointer;min-height:40px;padding:8px 0;color:#246bb3}.field-error{display:block;color:#a52d20!important;font-size:13px!important;margin-top:6px}[aria-invalid=true]{outline:2px solid #b44234}.field select{font:inherit;display:block;width:100%;min-height:44px;margin-top:8px;padding:10px;color:#203247;background:white;border:1px solid #bacbdb;border-radius:6px}.field input,.field textarea,.field select{font-size:16px}.actions{position:sticky;bottom:0;background:#f5f7fa;padding:10px 0 max(10px,env(safe-area-inset-bottom));z-index:2}input,textarea,select,button,a,summary{touch-action:manipulation;scroll-margin-block:90px}#contact-fields h3{margin:24px 0 8px}#contact-fields>.muted{margin:0 0 10px}select:focus-visible,summary:focus-visible{outline:3px solid #3189df;outline-offset:3px}button:hover,.button:hover{filter:brightness(.97)}#followup-form{border-top:1px solid #dce6f0;margin:20px 0;padding-top:10px}#followup-form .field{margin:14px 0}\n@media(max-width:600px){.hero{padding:18px 0 10px}.hero .lead{font-size:15px}.card{padding:18px 14px}.choice-grid{grid-template-columns:1fr}.subchoices{padding:2px 6px 10px}.subchoices .choice,.answer-edit,.material-done{min-height:44px}.steps button{font-size:12px}.formgrid{gap:0}.actions{padding-bottom:max(10px,env(safe-area-inset-bottom))}.draftbar{margin-top:18px}.footer{padding:22px 0}}\n@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}\n@media print{.actions,.answer-edit,.material-done{display:none!important}.full-answers{display:block}}\n/* Keep the first answers within reach, without shrinking their text or tap targets. */\n#section-number{display:none}#section-description{margin:6px 0 12px}#section-title{font-size:24px;margin-bottom:6px}.choice-field:first-child{margin-top:16px}.hero{padding:16px 0 10px}.hero>.muted{font-size:12px;margin:6px 0}.steps{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:4px}.steps button{line-height:1.25;padding:6px;min-height:44px}.mast{padding:14px 0}\n@media(max-width:600px){.hero h1{font-size:28px}.hero .lead{font-size:14px;line-height:1.45}.steps button{font-size:11px}.card{margin:12px 0;padding:16px 14px}#section-description{font-size:13px}}\n"
