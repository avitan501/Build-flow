"<main class=\"wrap quick-request\">\n<header class=\"mast\"><a class=\"brand\" href=\"/\" aria-label=\"Avantia Build homepage\">AVANTIA<span>BUILD</span></a></header>\n<section class=\"hero\"><p class=\"eyebrow\">YOUR MATERIALS CONCIERGE</p><h1>What can we take off your list?</h1><p class=\"lead\">Pick what you need. We’ll help with quotes, approved orders and deliveries.</p></section>\n<div id=\"loading\" role=\"status\"></div>\n<section id=\"form-area\">\n<div class=\"progress-row\"><span id=\"step-count\"></span><span id=\"answer-count\" hidden></span></div><progress id=\"progress\" max=\"3\" value=\"1\" aria-label=\"Questionnaire progress\"></progress>\n<nav id=\"steps\" class=\"steps\" aria-label=\"Questionnaire sections\"></nav>\n<form id=\"questionnaire\" novalidate>\n<section class=\"card\" id=\"section\" aria-labelledby=\"section-title\"><h2 id=\"section-title\" class=\"sr-only\" tabindex=\"-1\"></h2><div id=\"fields\"></div><div id=\"contact-fields\"></div></section>\n<div class=\"trap\" aria-hidden=\"true\"><label>Your website<input id=\"website\" type=\"text\" tabindex=\"-1\" autocomplete=\"off\"></label></div>\n<div id=\"review\" class=\"card\" hidden><h2 tabindex=\"-1\" id=\"review-title\">Review your request</h2><p class=\"muted\">Check your choices, then send.</p><div id=\"plan-recap\" class=\"plan-recap\"></div><details class=\"full-answers\"><summary>View all answers</summary><div id=\"summary\"></div></details><label class=\"consent\"><input type=\"checkbox\" id=\"consent\"> <span>I agree to share these answers with Avantia Build and be contacted about my request.</span></label><p class=\"muted\">Submitting is a request to discuss help. It does not authorize a purchase or agree to a fee.</p></div>\n<p id=\"error\" role=\"alert\" class=\"error\" hidden></p>\n<div class=\"actions\"><p id=\"selection-status\" role=\"status\" aria-live=\"polite\" hidden></p><button type=\"button\" id=\"previous\">← Back</button><button type=\"button\" class=\"primary\" id=\"next\">Continue →</button></div>\n</form>\n<div class=\"draftbar\"><p id=\"draft-status\" role=\"status\">Draft saved in this tab until you close it. Shared only when you send.</p><div class=\"toolbar\"><button type=\"button\" id=\"download\">Download my priorities</button><button type=\"button\" id=\"clear\">Clear draft</button></div></div>\n</section>\n<section id=\"success\" class=\"card\" hidden><h2 id=\"success-title\" tabindex=\"-1\">Your request is received.</h2><p>We’ll contact you to discuss the next steps.</p><p class=\"muted\" id=\"receipt\"></p>\n<form id=\"followup-form\" novalidate>\n<h3>Add project details (optional)</h3><p class=\"muted\">Your request is received. Add details or skip.</p>\n<label class=\"field\">Project town or ZIP code <span class=\"muted\">(optional)</span><input id=\"followup-location\" type=\"text\" maxlength=\"180\" autocomplete=\"address-level2\"></label>\n<label class=\"field\">When do you need the first materials? <span class=\"muted\">(optional)</span><select id=\"followup-timing\"><option value=\"\">Choose a timeframe</option><option>Soon</option><option>Within a month</option><option>Later / still planning</option><option>Specific date</option></select></label>\n<label class=\"field\" id=\"followup-date-field\" hidden>Preferred date<input id=\"followup-date\" type=\"date\"></label>\n<p id=\"followup-error\" role=\"alert\" class=\"error\" hidden></p>\n<div class=\"toolbar\"><button id=\"followup-save\" type=\"submit\" class=\"primary\">Save extra details</button><button id=\"followup-skip\" type=\"button\">Skip for now</button></div>\n</form><p id=\"followup-status\" role=\"status\" class=\"muted\"></p><div class=\"toolbar\"><button id=\"download-submitted\" type=\"button\">Download my priorities</button><a class=\"button primary\" href=\"/consultation\">Schedule a conversation</a><button id=\"another\" type=\"button\">Start another response</button></div></section>\n<footer class=\"footer\">AVANTIA BUILD <span>Construction concierge · Your project, your decisions.</span></footer>\n</main>\n<script>\n(() => {\n'use strict';\nconst cfg=window.questionnaireConfig,sections=cfg.sections,api='/api/client-questionnaire',key='avantia:client-questionnaire:v1',receiptKey=key+':receipt';\nconst $=id=>document.getElementById(id);\nconst el=(tag,text,cls)=>{const node=document.createElement(tag);if(text!==undefined)node.textContent=text;if(cls)node.className=cls;return node};\nconst materialsStep=sections.findIndex(s=>s.questions.some(q=>q.id==='departments'));\nconst empty=()=>({flowVersion:2,id:crypto.randomUUID(),state:{type:'avantia-client-questionnaire-v1',profile:{name:'',company:'',email:'',phone:''},answers:{},consent:false},step:0,choices:{},other:{},followups:{},followupOther:{}});\nlet draft=empty(),busy=false,dirty=false,storage=true,confirmation=null,activeMaterial=null;\ntry {\n const saved=JSON.parse(sessionStorage.getItem(key)||'null');\n if(saved&&/^[a-f0-9-]{36}$/.test(saved.id)&&saved.state?.type===draft.state.type&&['name','company','email','phone'].every(k=>typeof saved.state.profile?.[k]==='string')&&saved.state.answers&&Object.values(saved.state.answers).every(v=>typeof v==='string')) {\n  draft={...empty(),...saved};const previousStep=Number(saved.step)||0;draft.step=Math.max(0,Math.min(sections.length,saved.flowVersion===2?previousStep:previousStep-1));draft.flowVersion=2;\n }\n confirmation=JSON.parse(sessionStorage.getItem(receiptKey)||'null');\n if(!confirmation?.id||!confirmation?.state)confirmation=null;\n} catch {storage=false}\nfor(const field of ['choices','other','followups','followupOther'])draft[field]=draft[field]||{};\n// Preserve saved selections and details through category renames and the finish split.\nconst materialRenames={'Lumber / framing':['Lumber & framing'],'Roofing / siding':['Roofing & siding'],'Drywall / insulation':['Drywall & insulation'],'Dumpster':['Dumpster rental']};\nfor(const old of ['Interior finishes','Flooring, tile, doors & trim']){\n const products=draft.followups['departments:'+old+':products'],selected=Array.isArray(products)?products:products?[products]:[];\n const names=[];if(selected.includes('Flooring / tile'))names.push('Flooring & tile');if(selected.includes('Doors / trim'))names.push('Doors & trim');\n materialRenames[old]=names.length?names:['Flooring & tile','Doors & trim'];\n}\nif(Array.isArray(draft.choices.departments))draft.choices.departments=[...new Set(draft.choices.departments.flatMap(v=>materialRenames[v]||[v]))];\nfor(const bucket of ['followups','followupOther'])for(const oldKey of Object.keys(draft[bucket]))for(const [old,names]of Object.entries(materialRenames))if(oldKey.startsWith('departments:'+old+':')){\n for(const name of names){const newKey=oldKey.replace('departments:'+old+':','departments:'+name+':');if(!(newKey in draft[bucket]))draft[bucket][newKey]=draft[bucket][oldKey]}\n delete draft[bucket][oldKey];\n}\nconst materialsQuestion=sections.flatMap(s=>s.questions).find(q=>q.id==='departments');\nfunction persist(){dirty=true;try{sessionStorage.setItem(key,JSON.stringify(draft))}catch{storage=false}if(!storage)$('draft-status').textContent='Keep this page open or download your answers. Draft saving is unavailable.';updateCount()}\nfunction saveConfirmation(){try{sessionStorage.setItem(receiptKey,JSON.stringify(confirmation))}catch{}}\nfunction updateCount(){$('answer-count').textContent=draft.step===sections.length?'Ready for your review':'Your choices stay editable';const count=(draft.choices.departments||[]).length,status=$('selection-status');status.hidden=draft.step!==materialsStep||!count;status.textContent=count+' '+(count===1?'category':'categories')+' selected · Details can wait.';}\nfunction materialIllustration(value){\n const drawings={\n 'Lumber & framing':'<path d=\"M5 13 27 5l16 8-22 9Z\"/><path d=\"M5 13v10l16 9 22-9V13M21 22v10M5 27v8l16 9 22-9v-8M21 36v8M12 14l20-7M12 30l8 4\"/>',\n 'Roofing & siding':'<path d=\"m4 25 20-18 20 18M10 23v20h28V23M9 20h30M16 14h16M11 29h26M11 35h26M21 23v6M29 29v6M19 35v8\"/>',\n 'Drywall & insulation':'<path d=\"M8 10h26v32H8zM14 10V6h26v32h-6M8 20h26M18 10v10M25 20v22M8 31h17\"/><path d=\"M12 14h2M28 15h2M12 36h2M28 36h2\"/>',\n 'Flooring & tile':'<path d=\"m4 24 20-17 20 17-20 17Z M14 15l20 17M24 7l20 17M14 33l20-17M4 24l20 17M24 41l20-17M4 30l20 17 20-17\"/>',\n 'Doors & trim':'<path d=\"M10 44V5h28v39M15 44V10h18v34M7 44h34M19 14h10v12H19zM19 32h10v8H19z\"/><circle cx=\"29\" cy=\"29\" r=\"1\"/>',\n 'Dumpster rental':'<path d=\"M5 17h38l-4 22H10ZM3 12h42v5H3zM13 22l2 12M23 22v12M34 22l-2 12\"/><circle cx=\"15\" cy=\"42\" r=\"3\"/><circle cx=\"34\" cy=\"42\" r=\"3\"/>',\n '__other':'<rect x=\"8\" y=\"8\" width=\"32\" height=\"32\" rx=\"8\"/><path d=\"M24 16v16M16 24h16\"/>'};\n const icon=document.createElementNS('http://www.w3.org/2000/svg','svg');icon.setAttribute('viewBox','0 0 48 48');icon.setAttribute('aria-hidden','true');icon.setAttribute('focusable','false');icon.setAttribute('class','material-illustration');icon.innerHTML=drawings[value]||drawings.__other;return icon;\n}\n\nfunction clearError(){document.querySelectorAll('.field-error').forEach(n=>n.remove());document.querySelectorAll('[aria-invalid]').forEach(n=>n.removeAttribute('aria-invalid'));$('error').hidden=true;$('error').textContent=''}\nfunction showError(text,id){const target=$(id);if(target){target.setAttribute('aria-invalid','true');const note=el('small',text,'field-error');note.id=id+'-error';note.setAttribute('role','alert');target.parentElement.append(note);target.setAttribute('aria-describedby',note.id);target.focus()}else{$('error').textContent=text;$('error').hidden=false}}\nfunction field(label,value,oninput,{id,required=false,type='textarea',max=2500,hint=''}={}){\n const box=el('label',undefined,'field');box.append(el('span',label+(required?' *':type==='email'||type==='tel'?'':' (optional)')));\n const input=el(type==='textarea'?'textarea':'input');input.id=id;input.name=id;input.dir='auto';input.value=value||'';input.maxLength=max;input.required=required;\n if(type==='textarea')input.rows=2;else input.type=type;\n if(type==='email'){input.autocomplete='email';input.spellcheck=false}if(type==='tel')input.autocomplete='tel';if(id==='name')input.autocomplete='name';if(id==='company')input.autocomplete='organization';\n input.oninput=()=>{oninput(input.value);persist();clearError()};box.append(input);\n if(hint){const help=el('small',hint);help.id=id+'-help';input.setAttribute('aria-describedby',help.id);box.append(help)}return box;\n}\nfunction pickedFor(q){\n if(!Array.isArray(draft.choices[q.id])){draft.other[q.id]=draft.state.answers[q.id]||'';draft.choices[q.id]=draft.other[q.id]?['__other']:[]}\n const old=draft.choices[q.id].filter(v=>v!=='__other'&&!q.choices.includes(v));\n if(old.length){draft.other[q.id]=[draft.other[q.id],...old].filter(Boolean).join('\\n');draft.choices[q.id]=[...draft.choices[q.id].filter(v=>q.choices.includes(v)),'__other']}\n return new Set(draft.choices[q.id]);\n}\nfunction followupValues(parent,f){const id=materialsQuestion.id+':'+parent+':'+f.id,value=draft.followups[id];const values=Array.isArray(value)?value:value?[value]:[];return values.map(v=>v==='__other'?(draft.followupOther[id]?.trim()||'Other — discuss with me'):v)}\nfunction serviceGroups(){return materialsQuestion.choices.filter(v=>draft.choices.departments?.includes(v)).flatMap(parent=>{const services=(materialsQuestion.followups?.[parent]||[]).filter(f=>f.service).flatMap(f=>followupValues(parent,f));return services.length?[{parent,services}]:[]})}\nfunction generalHelp(){const q=sections.flatMap(s=>s.questions).find(q=>q.id==='priorities');return (draft.choices.priorities||[]).map(v=>v==='__other'?(draft.other.priorities?.trim()||'Other — discuss with me'):v).filter(v=>v==='Other — discuss with me'||v===draft.other.priorities?.trim()||q.choices.includes(v))}\nfunction updateServices(){\n const groups=serviceGroups(),general=generalHelp();draft.state.answers.priorities=groups.length?groups.map(g=>g.parent+': '+g.services.join('; ')).join('\\n')+(general.length?'\\nAdditional help: '+general.join('; '):''):general.join('\\n');\n const selected=draft.choices.departments||[];\n if(!draft.state.answers.priorities?.trim()&&selected.length)draft.state.answers.priorities=selected.map(v=>v==='__other'?(draft.other.departments?.trim()||'Other materials'):v).join('; ')+': Help me plan the next steps.';\n const fallback=$('priorities-field');if(fallback)fallback.hidden=selected.length>0;\n const notice=$('services-notice');if(notice){notice.hidden=!groups.length;notice.textContent='Your selected services will appear in your recap. You don’t need to choose them again.'}\n}\nfunction compose(q,selected){\n const values=q.choices.filter(v=>selected.has(v)).map(parent=>{\n  const fs=q.followups?.[parent];if(!fs)return parent;\n  const details=fs.flatMap(f=>{const v=followupValues(parent,f);return v.length?[f.text+' '+v.join('; ')]:[]});\n  for(const f of q.earlierFollowups?.[parent]||[]){const v=followupValues(parent,f);if(v.length)details.push('Earlier answer — '+f.text+' '+v.join('; '))}\n  return parent+(details.length?'\\n  '+details.join('\\n  '):'');\n });\n if(selected.has('__other'))values.push(draft.other[q.id]?.trim()?'Other: '+draft.other[q.id].trim():'Other — discuss with me');\n draft.state.answers[q.id]=values.join('\\n');updateServices();persist();clearError();\n}\nfunction choiceField(q){\n const box=el('fieldset',undefined,'choice-field');box.id=q.id+'-field';box.append(el('legend',q.text+(q.required?' *':'')));if(q.hint)box.append(el('p',q.hint,'muted'));\n const selected=pickedFor(q),grid=el('div',undefined,'choice-grid'),panels=[];\n const custom=field('Tell us more',draft.other[q.id]||'',v=>{draft.other[q.id]=v;sync()},{id:q.id,max:2000});custom.hidden=!selected.has('__other');\n function sync(){draft.choices[q.id]=[...selected];compose(q,selected)}\n function panelsUpdate(){for(const item of panels){const chosen=selected.has(item.parent),open=chosen&&activeMaterial===item.parent;item.panel.hidden=!open;item.edit.hidden=!chosen||open;item.tile.classList.toggle('expanded',open);item.toggle.setAttribute('aria-expanded',String(open))}}\n [...q.choices,'__other'].forEach((value,index)=>{\n  const label=el('label',undefined,'choice'),input=el('input');input.type=q.multiple===false?'radio':'checkbox';input.name=q.id;input.id=q.id+'-choice-'+index;input.value=value;input.checked=selected.has(value);label.append(input);if(q.id==='departments')label.append(materialIllustration(value));label.append(el('span',value==='__other'?'Other':value));\n  input.onchange=()=>{\n   if(q.multiple===false)selected.clear();\n   if(input.checked){if(q.exclusive?.includes(value))selected.clear();else q.exclusive?.forEach(v=>selected.delete(v));selected.add(value)}else selected.delete(value);\n   grid.querySelectorAll('input[data-main-choice]').forEach(n=>n.checked=selected.has(n.value));\n   custom.hidden=!selected.has('__other');if(value==='__other'&&input.checked)custom.querySelector('textarea').focus();\n   if(q.followups?.[value])activeMaterial=null;\n   panelsUpdate();sync();\n  };\n  input.dataset.mainChoice='true';\n  const followups=q.followups?.[value];if(!followups){grid.append(label);return}\n  const tile=el('div',undefined,'choice-with-followup'),panel=el('div',undefined,'subchoices'),edit=el('button','Add / edit details','answer-edit');edit.type='button';edit.setAttribute('aria-label','Edit '+value+' details');panel.id=q.id+'-material-'+index+'-subchoices';input.setAttribute('aria-controls',panel.id);\n  edit.onclick=()=>{activeMaterial=value;panelsUpdate();panel.querySelector('input,button')?.focus()};\n  if(q.materialHints?.[value])panel.append(el('p',q.materialHints[value],'muted'));\n  for(const f of followups)panel.append(followupField(q,value,index,f,sync));\n  const done=el('button','Done with '+value,'material-done');done.type='button';done.onclick=()=>{activeMaterial=null;panelsUpdate();edit.focus()};panel.append(done);tile.append(label,edit,panel);grid.append(tile);panels.push({parent:value,panel,edit,tile,toggle:input});\n });\n box.append(grid,custom);panelsUpdate();return box;\n}\nfunction followupField(q,parent,index,f,sync){\n const id=q.id+':'+parent+':'+f.id,domId=q.id+'-material-'+index+'-'+f.id;\n const stored=draft.followups[id],picked=new Set(Array.isArray(stored)?stored:stored?[stored]:[]);\n const old=[...picked].filter(v=>v!=='__other'&&!f.choices.includes(v));if(old.length){old.forEach(v=>picked.delete(v));picked.add('__other');draft.followupOther[id]=[draft.followupOther[id],...old].filter(Boolean).join('; ');draft.followups[id]=f.multiple?[...picked]:'__other'}\n const row=el('div',undefined,'question-slide'),compact=el('div',undefined,'answered-row'),caption=el('span',undefined,'picker-value'),edit=el('button',f.multiple?'Add / change':'Change','answer-edit');edit.type='button';edit.setAttribute('aria-label','Change: '+f.text);compact.append(el('span',f.text,'answered-question'),caption,edit);\n const group=el('fieldset',undefined,'followup'),choices=el('div',undefined,'choice-grid');group.append(el('legend',f.text));if(f.multiple)group.append(el('small','Select any that apply, then Done.','muted'));\n function collapse(focus=false){caption.textContent='✓ '+[...picked].map(v=>v==='__other'?(draft.followupOther[id]?.trim()||'Other'):v).join(' · ');group.hidden=picked.size>0;compact.hidden=!group.hidden;if(focus&&group.hidden)edit.focus()}\n edit.onclick=()=>{group.hidden=false;compact.hidden=true;group.querySelector('input')?.focus()};\n const other=field('Tell us more',draft.followupOther[id]||'',v=>{draft.followupOther[id]=v;sync()},{id:domId+'-other',max:200});other.hidden=!picked.has('__other');\n [...f.choices,'__other'].forEach((value,i)=>{const label=el('label',undefined,'choice'),input=el('input');input.type=f.multiple?'checkbox':'radio';input.name=id;input.id=domId+'-'+i;input.value=value;input.checked=picked.has(value);label.append(input,el('span',value==='__other'?'Other':value));input.onchange=()=>{if(!f.multiple)picked.clear();if(input.checked)picked.add(value);else picked.delete(value);draft.followups[id]=f.multiple?[...picked]:value;other.hidden=!picked.has('__other');sync();if(!f.multiple&&value!=='__other')collapse(true);if(value==='__other'&&input.checked)other.querySelector('textarea').focus()};choices.append(label)});\n const done=el('button','Done','answer-edit');done.type='button';done.setAttribute('aria-label','Done: '+f.text);done.onclick=()=>collapse(true);group.append(choices,other,done);row.append(compact,group);collapse();return row;\n}\nfunction renderContact(){\n const area=$('contact-fields');area.replaceChildren();if(draft.step!==sections.length-1)return;\n area.append(el('h3','How can we reach you?'),el('p','So we can follow up. Email or phone—your choice.','muted'));\n const grid=el('div',undefined,'formgrid');for(const [id,label,type,max,required]of [['name','Your name','text',180,true],['email','Email','email',254,false],['phone','Phone','tel',40,false]])grid.append(field(label,draft.state.profile[id],v=>draft.state.profile[id]=v,{id,type,max,required}));area.append(grid);\n}\nfunction renderReview(){\n const recap=$('plan-recap');recap.replaceChildren();\n const chosen=draft.choices.departments||[],groups=serviceGroups();\n for(const name of chosen){const title=name==='__other'?(draft.other.departments||'Other materials'):name,block=el('div',undefined,'recap-material');block.append(el('strong',title));const services=groups.find(g=>g.parent===name)?.services;block.append(el('p',services?.join(' · ')||'We’ll discuss the details together.'));recap.append(block)}\n if(!chosen.length)recap.append(el('p','We’ll choose the materials to focus on together.'));\n const general=generalHelp();if(general.length)recap.append(el('p',(groups.length?'Additional help: ':'Requested help: ')+general.join(' · ')));\n recap.append(el('p','Delivery: '+(draft.state.answers.next_step||'Not chosen yet')));\n const edit=el('button','Edit materials and help','answer-edit');edit.type='button';edit.onclick=()=>{draft.step=materialsStep;render(true)};recap.append(edit);\n const contact=el('p',[draft.state.profile.name,draft.state.profile.email,draft.state.profile.phone].filter(Boolean).join(' · '));recap.append(contact);\n const editContact=el('button','Edit delivery or contact','answer-edit');editContact.type='button';editContact.onclick=()=>{draft.step=sections.length-1;render(true)};recap.append(editContact);\n const summary=$('summary');summary.replaceChildren();for(const s of sections){const part=el('section',undefined,'review-section');part.append(el('h3',s.title));for(const q of s.questions)if(draft.state.answers[q.id]?.trim())part.append(el('h4',q.text),el('p',draft.state.answers[q.id],'answer'));summary.append(part)}\n for(const q of cfg.legacyQuestions||[])if(draft.state.answers[q.id])summary.append(el('h4',q.text),el('p',draft.state.answers[q.id],'answer'));\n}\nfunction render(focus=false){\n document.querySelector('.hero').hidden=draft.step>0;\n clearError();const step=draft.step;$('section').hidden=step===sections.length;$('review').hidden=step!==sections.length;$('previous').hidden=step===0;$('next').textContent=step===sections.length?'Send my request':step===sections.length-1?'Review my request →':'Continue →';$('step-count').textContent='Step '+(step+1)+' of '+(sections.length+1);$('progress').max=sections.length+1;$('progress').value=step+1;$('consent').checked=draft.state.consent===true;\n $('steps').replaceChildren();[...sections.map(s=>s.title),'Review'].forEach((label,i)=>{const button=el('button',(i+1)+'. '+label);button.type='button';if(i===step)button.setAttribute('aria-current','step');button.onclick=()=>{if(!busy)navigate(i)};$('steps').append(button)});\n if(step<sections.length){const s=sections[step];$('section-title').textContent=s.title;$('fields').replaceChildren();for(const q of s.questions){const field=choiceField(q);if(q.id==='friction'){const disclosure=el('details',undefined,'optional-question');disclosure.id='friction-disclosure';const summary=el('summary',q.text+' (optional)');field.setAttribute('aria-label',q.text);disclosure.append(summary,field);$('fields').append(disclosure)}else $('fields').append(field)}renderContact();updateServices();if(focus)$('section-title').focus()}\n else{updateServices();renderReview();if(focus)$('review-title').focus()}updateCount();\n}\nfunction contactInvalid(){const p=draft.state.profile;if(!p.name.trim())return {id:'name',message:'Please enter your name.'};if(!p.email.trim()&&!p.phone.trim())return {id:'email',message:'Please enter an email or a phone number.'};const email=el('input');email.type='email';email.value=p.email;if(p.email&&!email.checkValidity())return {id:'email',message:'Please check your email address.'};return null}\nfunction stepInvalid(step){if(step===materialsStep&&!draft.state.answers.priorities?.trim())return {id:'priorities-choice-0',message:'Choose the help you want, or “Help me decide where to start”.'};if(step===sections.length-1){if(!draft.state.answers.next_step?.trim())return {id:'next_step-choice-0',message:'Choose a delivery approach, or ask us to help plan it.'};return contactInvalid()}return null}\nfunction navigate(target){clearError();if(target>draft.step){const bad=stepInvalid(draft.step);if(bad){showError(bad.message,bad.id);return}}draft.step=target;persist();render(true)}\nfunction setBusy(value){busy=value;document.querySelectorAll('#questionnaire button,#questionnaire input,#questionnaire textarea,#steps button').forEach(n=>n.disabled=value);$('next').textContent=value?'Sending…':'Send my request'}\nfunction download(){const state=confirmation?{...confirmation.state,...(confirmation.details?{followup:confirmation.details}:{})}:draft.state;const url=URL.createObjectURL(new Blob([JSON.stringify(state,null,2)],{type:'application/json'})),a=el('a');a.href=url;a.download='avantia-