"<style>\nhtml{color-scheme:light}body{margin:0;background:#fff;color:#173d33;font-family:Arial,sans-serif}\n#avantia-checklist .toolbar{display:flex;gap:10px;flex-wrap:wrap;align-items:center;padding:12px 16px;border-bottom:1px solid #d8e5df}\n#avantia-checklist button,#avantia-checklist .toolbar a{font:inherit;padding:10px 12px;border:1px solid #c6d8cf;border-radius:5px;background:#fff;color:#173d33;cursor:pointer;text-decoration:none}\n#avantia-checklist .whatsapp{font-size:18px;font-weight:600;color:#145e43;display:block;text-underline-offset:4px}\n#avantia-checklist #recovery,#avantia-checklist #versions{padding:16px;background:#fff3e5}\n#avantia-checklist #versions button{margin:5px}\n#avantia-checklist #customer table{min-width:800px;table-layout:fixed}\n#avantia-checklist #customer th:nth-child(1){width:10%}\n#avantia-checklist #customer th:nth-child(2){width:20%}\n#avantia-checklist #customer th:nth-child(3){width:22%}\n#avantia-checklist #customer th:nth-child(4){width:22%}\n#avantia-checklist #customer th:nth-child(5){width:26%}\n#avantia-checklist #customer{overflow:auto}\n#avantia-checklist #customer td{white-space:pre-line;overflow-wrap:anywhere}\n#avantia-checklist #customer p{padding:0 16px}\n#avantia-checklist.preview .sheet,#avantia-checklist.preview .legend{display:none}\n@page{size:letter landscape;margin:0.25in}\n@media print{\n  #avantia-checklist .toolbar,#avantia-checklist .sheet,#avantia-checklist .legend,#avantia-checklist #av-save,#avantia-checklist #versions,#avantia-checklist #recovery{display:none!important}\n  #avantia-checklist #customer{display:block!important;overflow:visible}\n  #avantia-checklist #customer table{min-width:0;width:100%;font-size:8px;line-height:1.1}\n  #avantia-checklist #customer th{font-size:8px;padding:3px}\n  #avantia-checklist #customer td{padding:2px 3px}\n  #avantia-checklist header{padding:4px}#avantia-checklist h2{font-size:16px;margin:0}\n  #avantia-checklist .offer{padding:4px;font-size:9px}#avantia-checklist .whatsapp{font-size:12px}\n  #avantia-checklist .offer p{margin:3px 0}#avantia-checklist .benefits{gap:4px 12px}\n  #avantia-checklist #customer p{font-size:8px;margin:4px}\n  #avantia-checklist tr{break-inside:avoid}\n}\n</style>\n<script>\n(()=>{\nconst root=document.getElementById('avantia-checklist'),recovery=root.querySelector('#recovery'),versions=root.querySelector('#versions');\nconst endpoint='/api/owner/service-planner';let revision=window.plannerInitial.revision,blocked=false,inFlight=false;\nfunction backup(){const blob=new Blob([JSON.stringify(window.plannerSnapshot(),null,2)],{type:'application/json'});const url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='avantia-service-planner-backup.json';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);}\nroot.querySelector('#download').onclick=backup;\nfunction failure(message,conflict){recovery.hidden=false;recovery.replaceChildren();const p=document.createElement('p');p.textContent=message;recovery.append(p);const download=document.createElement('button');download.textContent='Download my edits';download.onclick=backup;recovery.append(download);const next=document.createElement('button');next.textContent=conflict?'Reload saved version':'Retry saving';next.onclick=()=>{if(conflict){if(confirm('Download your edits first if you want to keep them. Reload the saved version?')){window.plannerDirty=false;location.reload();}}else{blocked=false;window.plannerRestore(window.plannerSnapshot());}};recovery.append(next);}\nwindow.openai={setWidgetState:async snapshot=>{\n if(blocked)throw new Error('Save paused');\n inFlight=true;\n try{\n const response=await fetch(endpoint,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({revision,state:snapshot.modelContent})});\n if(!response.ok){blocked=true;failure(response.status===409?'Another tab saved a newer version. Your edits are still here; download them before reloading.':'Your edits are not saved yet. Keep this page open and retry.',response.status===409);throw new Error('Save failed');}\n const saved=await response.json();revision=saved.revision;recovery.hidden=true;\n }catch(error){if(!blocked){blocked=true;failure('Could not confirm the save. Keep your edits here and retry; a newer saved version will never be overwritten automatically.',false);}throw error;}finally{inFlight=false;}\n}};\nwindow.addEventListener('beforeunload',e=>{if(window.plannerDirty||inFlight){e.preventDefault();e.returnValue='';}});\nconst serviceNames=['Takeoff','Compare prices','Order at website price.','Book / schedule','Reorders & shortages','Subcontractor check','Talk to your subs'];\nconst painNames={reorders:'Frequent reorders',missing:'Missing materials / documents',pricing:'Overpaying / unclear pricing',calls:'Too many supplier calls',chasing:'Chasing bookings / deliveries',stores:'Shopping at several stores',quantities:'Unclear quantities',scope:'Unclear subcontractor inclusions',approvals:'Waiting for selections / approvals'};\nfunction customerPreview(){const target=root.querySelector('#customer');target.replaceChildren();const table=document.createElement('table'),head=document.createElement('thead'),hr=document.createElement('tr');['Department','Materials','Services','GC’s pain','What this takes off your plate'].forEach(name=>{const th=document.createElement('th');th.textContent=name;hr.append(th);});head.append(hr);table.append(head);const body=document.createElement('tbody');window.plannerRows(window.plannerSnapshot().rows).forEach(r=>{if(r.id===3){const section=document.createElement('tr'),heading=document.createElement('th');heading.colSpan=5;heading.textContent='Additional services / packages';section.append(heading);body.append(section);}const tr=document.createElement('tr');const labels=(key,names)=>r[key+'Ids'].filter(id=>key!=='solution'||!['contact','reorders','compare'].includes(id)).map(id=>id==='other'?r[key+'Other']:names[id]).filter(Boolean).map(v=>'✓ '+v).join('\\n');[r.department,r.items,window.plannerServices(r).map((v,i)=>v===true?'✓ '+serviceNames[i]:null).filter(Boolean).join('\\n'),labels('pain',painNames),window.plannerOutcome(r)].forEach(value=>{const td=document.createElement('td');td.textContent=value;tr.append(td);});body.append(tr);});table.append(body);target.append(table);const foot=document.createElement('p');foot.textContent='Avantia · WhatsApp (516) 990-1990 · avantiabuild.com';target.append(foot);}\nroot.querySelector('#preview').onclick=()=>{const preview=!root.classList.contains('preview');customerPreview();root.classList.toggle('preview',preview);root.querySelector('#customer').hidden=!preview;root.querySelector('#preview').textContent=preview?'Back to editing':'Customer preview';};\nroot.querySelector('#print').onclick=()=>{customerPreview();window.print();};window.addEventListener('beforeprint',customerPreview);\nroot.querySelector('#history').onclick=async()=>{\n if(!versions.hidden){versions.hidden=true;return;}versions.hidden=false;versions.textContent='Loading saved versions…';\n try{const response=await fetch(endpoint,{cache:'no-store'});if(!response.ok)throw new Error();const saved=await response.json();versions.replaceChildren();const title=document.createElement('p');title.textContent='Last 20 saved versions. Restoring creates a new version.';versions.append(title);if(!saved.history.length)versions.append(document.createTextNode('No earlier saved versions yet.'));\n saved.history.forEach(v=>{const button=document.createElement('button');button.textContent='Restore version '+v.revision+' · '+new Date(v.savedAt).toLocaleString();button.onclick=()=>{if(blocked||inFlight||window.plannerDirty){alert('Save or download your current edits before restoring a version.');return;}if(revision!==saved.revision){alert('The version list changed. Close it and open it again.');return;}if(confirm('Restore this version? Your current saved version remains in history.')){window.plannerRestore(v.state);versions.hidden=true;}};versions.append(button);});\n }catch{versions.textContent='Could not load saved versions. Close this panel and try again.';}\n};\n})();\n</script>\n"
