"<style>\nhtml{color-scheme:light}body{margin:0;background:#fff;color:#173d33;font-family:Arial,sans-serif}\n#avantia-checklist .toolbar{display:flex;gap:10px;flex-wrap:wrap;align-items:center;padding:12px 16px;border-bottom:1px solid #d8e5df}\n#avantia-checklist button,#avantia-checklist .toolbar a{font:inherit;padding:10px 12px;border:1px solid #c6d8cf;border-radius:5px;background:#fff;color:#173d33;cursor:pointer;text-decoration:none}\n#avantia-checklist .whatsapp{font-size:18px;font-weight:600;color:#145e43;display:block;text-underline-offset:4px}\n#avantia-checklist #recovery,#avantia-checklist #versions{padding:16px;background:#fff3e5}\n#avantia-checklist #versions button{margin:5px}\n#avantia-checklist #customer table{min-width:800px;table-layout:fixed}\n#avantia-checklist #customer th:nth-child(1){width:10%}\n#avantia-checklist #customer th:nth-child(2){width:20%}\n#avantia-checklist #customer th:nth-child(3){width:16%}\n#avantia-checklist #customer th:nth-child(4){width:16%}\n#avantia-checklist #customer th:nth-child(5){width:16%}\n#avantia-checklist #customer th:nth-child(6){width:22%}\n#avantia-checklist #customer{overflow:auto}\n#avantia-checklist #customer td{white-space:pre-line;overflow-wrap:anywhere}\n#avantia-checklist #customer p{padding:0 16px}\n#avantia-checklist.preview .sheet,#avantia-checklist.preview .legend{display:none}\n@page{size:letter landscape;margin:0.25in}\n@media print{\n  #avantia-checklist .toolbar,#avantia-checklist .sheet,#avantia-checklist .legend,#avantia-checklist #av-save,#avantia-checklist #versions,#avantia-checklist #recovery{display:none!important}\n  #avantia-checklist #customer{display:block!important;overflow:visible}\n  #avantia-checklist #customer table{min-width:0;width:100%;font-size:8px;line-height:1.1}\n  #avantia-checklist #customer th{font-size:8px;padding:3px}\n  #avantia-checklist #customer td{padding:2px 3px}\n  #avantia-checklist header{padding:4px}#avantia-checklist h2{font-size:16px;margin:0}\n  #avantia-checklist .offer{padding:4px;font-size:9px}#avantia-checklist .whatsapp{font-size:12px}\n  #avantia-checklist .offer p{margin:3px 0}#avantia-checklist .benefits{gap:4px 12px}\n  #avantia-checklist #customer p{font-size:8px;margin:4px}\n  #avantia-checklist tr{break-inside:avoid}\n}\n@media screen{\nhtml,body{background:#fff;color:#202329;font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif}\n#avantia-checklist{--av-bg:#fff;--av-fg:#202329;--av-line:#e3e5eb;--av-soft:#f6f7fa;--av-pain:#f6f7fa;--av-solve:#f6f7fa;font-family:inherit;font-size:14px;line-height:1.5;max-width:1500px;padding:0 28px 40px;margin:auto}\n#avantia-checklist header{background:#fff;padding:30px 0 22px;border-bottom:1px solid #eceef2;align-items:flex-start}\n#avantia-checklist .brand{display:block;letter-spacing:-.7px;font-size:25px;font-weight:750;color:#14171c}\n#avantia-checklist h2{font-size:22px;letter-spacing:-.5px;font-weight:650;margin:5px 0}\n#avantia-checklist header h2{font-size:16px;letter-spacing:0;color:#757b84;font-weight:400;margin-top:7px}\n#avantia-checklist #av-save{color:#646c79;padding:7px 12px;border:1px solid #e3e5eb;border-radius:20px;background:#fafbfc;font-size:11px}\n#avantia-checklist .offer{padding:22px 0;background:#fff}\n#avantia-checklist .whatsapp{font-size:18px;font-weight:600;color:#2677c9;text-decoration:none;letter-spacing:-.25px}\n#avantia-checklist .whatsapp:hover{text-decoration:underline}\n#avantia-checklist .offer p{color:#797e87;font-size:15px;margin:5px 0 16px}\n#avantia-checklist .benefits{gap:8px 20px;color:#606773;font-size:12px}\n#avantia-checklist .service-planning{padding:20px;background:#f7f8fb;border:1px solid #e3e5eb;border-radius:14px}\n#avantia-checklist .service-planning h2{font-size:18px}\n#avantia-checklist .service-planning>p{color:#737986;font-size:13px;margin:5px 0 18px}\n#avantia-checklist .service-editor{gap:16px}\n#avantia-checklist .service-editor article{padding:0;border:0;border-radius:0;background:transparent}\n#avantia-checklist .service-editor label>span{font-size:11px;letter-spacing:.25px;color:#747b87;font-weight:500}\n#avantia-checklist .service-editor textarea{border:1px solid #dde1e8;border-radius:7px;padding:9px;background:#fff;font-size:13px}\n#avantia-checklist .service-editor label:first-child textarea{font-weight:600}\n#avantia-checklist .service-editor label:nth-child(2) textarea{color:#2677c9;font-weight:600}\n#avantia-checklist .service-editor article:last-child label:nth-child(2) textarea{color:#202329}\n#avantia-checklist .fees{font-size:12px;color:#747b87;margin-top:6px}\n#avantia-checklist .toolbar{padding:20px 0 8px;border:0;gap:8px}\n#avantia-checklist button,#avantia-checklist .toolbar a{border:1px solid #e1e4ea;border-radius:8px;padding:9px 12px;color:#535b67;font-size:12px;background:#fff}\n#avantia-checklist button:hover,#avantia-checklist .toolbar a:hover{background:#f5f7fa;color:#202329}\n#avantia-checklist #preview{background:#2b7ccc;border-color:#2b7ccc;color:#fff;font-weight:600}\n#avantia-checklist .legend{padding:13px 0;color:#7a808a;font-size:12px}\n#avantia-checklist .sheet{border:1px solid #cdd1d9;border-radius:12px;max-height:76dvh}\n#avantia-checklist .sheet thead .service-groups th{background:#f1f3f7;color:#818894;font-size:10px;font-weight:600;letter-spacing:.6px;padding:9px 12px}\n#avantia-checklist .column-headings th{background:#f6f7fa;color:#676e79;font-size:12px;line-height:1.4;font-weight:500;padding:13px 12px;border-bottom:1px solid #e8eaf0}\n#avantia-checklist .column-headings th small{color:#8b9099;font-size:10px;line-height:1.4}\n#avantia-checklist .column-headings th:nth-child(7),#avantia-checklist .column-headings th:nth-child(8){background:#f6f7fa}\n#avantia-checklist td{padding:12px 10px;border-bottom:0;font-size:13px;vertical-align:middle}\n#avantia-checklist #av-body tr[data-row-id]:nth-child(odd)>td,#avantia-checklist #customer tbody tr:nth-child(odd)>td{background:#fff}\n#avantia-checklist #av-body tr[data-row-id]:nth-child(even)>td,#avantia-checklist #customer tbody tr:nth-child(even)>td{background:#f6f7fa}\n#avantia-checklist #av-body tr[data-row-id]:hover>td{background:#eef4fb}\n#avantia-checklist .support-start{border-left:1px solid #e1e5ec}\n#avantia-checklist tbody th{background:#edf0f5;color:#7b8390;padding:12px;font-size:11px;font-weight:500}\n#avantia-checklist textarea{border-radius:6px;min-height:44px;padding:5px;line-height:1.5}\n#avantia-checklist textarea:focus{outline:2px solid #2b7ccc;background:#fff}\n#avantia-checklist td:first-child textarea{font-weight:600;letter-spacing:-.15px;color:#22262d}\n#avantia-checklist .reference{font-size:10px;color:#9298a2;margin-top:3px}\n#avantia-checklist summary{font-size:12px;font-weight:500;color:#6c7481}\n#avantia-checklist .picked div{font-size:12px;color:#606976}\n#avantia-checklist .checklabel{position:relative;min-height:44px;cursor:pointer}\n#avantia-checklist .checklabel input{position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:pointer;z-index:1}\n#avantia-checklist .service-mark{display:inline-flex;align-items:center;justify-content:center;width:6px;height:6px;border-radius:50%;background:#dfe2e8;color:#fff;font-size:12px;font-weight:700}\n#avantia-checklist .checklabel input:checked+.service-mark{width:38px;height:24px;border-radius:6px;background:#2c7dcc}\n#avantia-checklist .checklabel input:checked+.service-mark:after{content:'✓'}\n#avantia-checklist .checklabel input:indeterminate+.service-mark{width:24px;height:24px;border-radius:6px;background:#e9edf3;color:#747e8c}\n#avantia-checklist .checklabel input:indeterminate+.service-mark:after{content:'?'}\n#avantia-checklist .support-start .checklabel input:checked+.service-mark{background:#23272d}\n#avantia-checklist .checklabel:has(input:focus-visible){outline:2px solid #2c7dcc;outline-offset:2px;border-radius:6px}\n#avantia-checklist .option input{accent-color:#2c7dcc}\n#avantia-checklist .service-offer{padding:20px 0;gap:16px}\n#avantia-checklist .service-offer article{border:0;border-left:2px solid #e6ebf2;border-radius:0;padding:4px 15px}\n#avantia-checklist .service-offer h3{font-size:15px;letter-spacing:-.2px;font-weight:600}\n#avantia-checklist .service-offer strong{font-size:18px;color:#287acb}\n#avantia-checklist .service-offer article:last-child strong{color:#23272d}\n#avantia-checklist .service-offer p{color:#737b87;font-size:13px}\n#avantia-checklist #customer{border:1px solid #cdd1d9;border-radius:12px;margin-top:12px}\n#avantia-checklist #customer th{background:#f6f7fa;color:#727b88;font-weight:500;padding:14px 12px;font-size:12px}\n#avantia-checklist #customer td{font-size:13px;padding:14px 12px;color:#414955}\n#avantia-checklist #customer td:first-child{font-weight:600;color:#202329}\n#avantia-checklist #customer>p{color:#8a919b;font-size:11px}\n@media(max-width:650px){\n#avantia-checklist{padding:0 16px 24px}\n#avantia-checklist header{padding:22px 0 18px;gap:12px}\n#avantia-checklist .brand{font-size:24px}\n#avantia-checklist .offer{padding:18px 0}\n#avantia-checklist .whatsapp{font-size:16px}\n#avantia-checklist .benefits{gap:9px;font-size:11px}\n#avantia-checklist .service-planning{padding:16px}\n#avantia-checklist .service-editor{gap:16px}\n#avantia-checklist .service-editor article+article{border-top:1px solid #e1e4eb;padding-top:16px}\n#avantia-checklist .service-editor textarea{font-size:16px}\n#avantia-checklist .toolbar{gap:7px}\n#avantia-checklist .toolbar button,#avantia-checklist .toolbar a{min-height:44px}\n#avantia-checklist .sheet td:first-child{box-shadow:1px 0 0 #e5e8ee}\n#avantia-checklist .service-offer{grid-template-columns:1fr;gap:20px}\n}}\n@media print{\n#avantia-checklist{--av-fg:#202329;--av-soft:#f5f6f9;--av-pain:#f5f6f9;--av-solve:#f5f6f9;color:#202329}\n#avantia-checklist .service-offer strong{color:#287acb}\n#avantia-checklist #customer tbody tr:nth-child(even)>td{background:#f5f6f9}\n#avantia-checklist .support-start{border-left:1px solid #e1e4eb}\n}\n\n</style>\n<script>\n(()=>{\nconst root=document.getElementById('avantia-checklist'),recovery=root.querySelector('#recovery'),versions=root.querySelector('#versions');\nconst endpoint='/api/owner/service-planner';let revision=window.plannerInitial.revision,blocked=false,inFlight=false;\nfunction backup(){const blob=new Blob([JSON.stringify(window.plannerSnapshot(),null,2)],{type:'application/json'});const url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='avantia-service-planner-backup.json';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);}\nroot.querySelector('#download').onclick=backup;\nfunction failure(message,conflict){recovery.hidden=false;recovery.replaceChildren();const p=document.createElement('p');p.textContent=message;recovery.append(p);const download=document.createElement('button');download.textContent='Download my edits';download.onclick=backup;recovery.append(download);const next=document.createElement('button');next.textContent=conflict?'Reload saved version':'Retry saving';next.onclick=()=>{if(conflict){if(confirm('Download your edits first if you want to keep them. Reload the saved version?')){window.plannerDirty=false;location.reload();}}else{blocked=false;window.plannerRestore(window.plannerSnapshot());}};recovery.append(next);}\nwindow.openai={setWidgetState:async snapshot=>{\n if(blocked)throw new Error('Save paused');\n inFlight=true;\n try{\n const response=await fetch(endpoint,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({revision,state:snapshot.modelContent})});\n if(!response.ok){blocked=true;failure(response.status===409?'Another tab saved a newer version. Your edits are still here; download them before reloading.':'Your edits are not saved yet. Keep this page open and retry.',response.status===409);throw new Error('Save failed');}\n const saved=await response.json();revision=saved.revision;recovery.hidden=true;\n }catch(error){if(!blocked){blocked=true;failure('Could not confirm the save. Keep your edits here and retry; a newer saved version will never be overwritten automatically.',false);}throw error;}finally{inFlight=false;}\n}};\nwindow.addEventListener('beforeunload',e=>{if(window.plannerDirty||inFlight){e.preventDefault();e.returnValue='';}});\nconst painNames={reorders:'Frequent reorders',missing:'Missing materials / documents',pricing:'Overpaying / unclear pricing',calls:'Too many supplier calls',chasing:'Chasing bookings / deliveries',stores:'Shopping at several stores',quantities:'Unclear quantities',scope:'Unclear subcontractor inclusions',approvals:'Waiting for selections / approvals'};\nfunction customerPreview(){const serviceNames=window.plannerServiceNames();const target=root.querySelector('#customer');target.replaceChildren();const table=document.createElement('table'),head=document.createElement('thead'),hr=document.createElement('tr');['Department','Materials','Main services','Support','GC’s pain','What this takes off your plate'].forEach(name=>{const th=document.createElement('th');th.textContent=name;if(name==='Support')th.className='support-start';hr.append(th);});head.append(hr);table.append(head);const body=document.createElement('tbody');window.plannerRows(window.plannerSnapshot().rows).forEach(r=>{if(r.id===3){const section=document.createElement('tr'),heading=document.createElement('th');heading.colSpan=6;heading.textContent='Additional services / packages';section.append(heading);body.append(section);}const tr=document.createElement('tr');const labels=(key,names)=>r[key+'Ids'].filter(id=>key!=='solution'||!['contact','reorders','compare'].includes(id)).map(id=>id==='other'?r[key+'Other']:names[id]).filter(Boolean).map(v=>'✓ '+v).join('\\n');[r.department,r.items,...[0,3].map(start=>window.plannerServices(r).slice(start,start+3).map((v,i)=>v===true?'✓ '+serviceNames[start+i]:null).filter(Boolean).join('\\n')),labels('pain',painNames),window.plannerOutcome(r)].forEach((value,index)=>{const td=document.createElement('td');td.textContent=value;if(index===3)td.className='support-start';tr.append(td);});body.append(tr);});table.append(body);target.append(table);const foot=document.createElement('p');foot.textContent='Avantia · WhatsApp (516) 990-1990 · avantiabuild.com';target.append(foot);}\nroot.querySelector('#preview').onclick=()=>{const preview=!root.classList.contains('preview');customerPreview();root.classList.toggle('preview',preview);root.querySelector('#customer').hidden=!preview;root.querySelector('#preview').textContent=preview?'Back to editing':'Customer preview';};\nroot.querySelector('#print').onclick=()=>{customerPreview();window.print();};window.addEventListener('beforeprint',customerPreview);\nroot.querySelector('#history').onclick=async()=>{\n if(!versions.hidden){versions.hidden=true;return;}versions.hidden=false;versions.textContent='Loading saved versions…';\n try{const response=await fetch(endpoint,{cache:'no-store'});if(!response.ok)throw new Error();const saved=await response.json();versions.replaceChildren();const title=document.createElement('p');title.textContent='Last 20 saved versions. Restoring creates a new version.';versions.append(title);if(!saved.history.length)versions.append(document.createTextNode('No earlier saved versions yet.'));\n saved.history.forEach(v=>{const button=document.createElement('button');button.textContent='Restore version '+v.revision+' · '+new Date(v.savedAt).toLocaleString();button.onclick=()=>{if(blocked||inFlight||window.plannerDirty){alert('Save or download your current edits before restoring a version.');return;}if(revision!==saved.revision){alert('The version list changed. Close it and open it again.');return;}if(confirm('Restore this version? Your current saved version remains in history.')){window.plannerRestore(v.state);versions.hidden=true;}};versions.append(button);});\n }catch{versions.textContent='Could not load saved versions. Close this panel and try again.';}\n};\n})();\n</script>\n"
