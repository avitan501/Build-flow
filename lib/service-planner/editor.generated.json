"<div id=\"avantia-checklist\">\n  <header><div><span class=\"brand\">AVANTIA</span><h2>One contact. Fewer supplier calls.</h2></div><span id=\"av-save\" role=\"status\" aria-live=\"polite\">Saved workspace · Owner only</span></header>\n  <section class=\"offer\"><a class=\"whatsapp\" href=\"https://wa.me/15169901990?text=Hi%20Avantia%2C%20I%20would%20like%20to%20send%20my%20material%20list%20or%20supplier%20quote.\" target=\"_blank\" rel=\"noopener noreferrer\">Send Avantia your material list or supplier quote on WhatsApp ↗</a><p>Your materials and site services. One phone number.</p><div class=\"benefits\"><span>📞 One supplier contact</span><span>🔁 Reorder through WhatsApp</span><span>💲 Compare quotes / negotiate bulk pricing</span><span>🏦 One payment to Avantia. We pay your suppliers.</span><span>🚚 Store doesn’t deliver? We arrange delivery.</span><span>⚡ Urgent material needs? We help source them.</span></div></section>\n  <nav class=\"toolbar\"><a href=\"/admin/build-map?section=manager-tools#manager-tools\">← Manager tools</a><button id=\"preview\" type=\"button\">Customer preview</button><button id=\"print\" type=\"button\">Print flyer</button><button id=\"history\" type=\"button\">Saved versions</button><button id=\"download\" type=\"button\">Download backup</button></nav><div id=\"recovery\" role=\"alert\" hidden></div><div id=\"versions\" hidden></div><div id=\"customer\" hidden></div><div class=\"legend\">☑ Selected &nbsp; ☐ Not selected &nbsp; ▣ To confirm</div>\n  <div class=\"sheet\" role=\"region\" aria-label=\"Scrollable service planner\" tabindex=\"0\"><table aria-label=\"Editable Avantia department and service checklist\"><colgroup><col style=\"width:11%\"><col style=\"width:17%\"><col style=\"width:5%\"><col style=\"width:6%\"><col style=\"width:7%\"><col style=\"width:6%\"><col style=\"width:8%\"><col style=\"width:10%\"><col style=\"width:9%\"><col style=\"width:14%\"><col style=\"width:16%\"></colgroup><thead><tr><th>Department</th><th>Items / supplies</th><th>📐<br>Takeoff</th><th>💲<br>Compare prices</th><th>🛒<br>Order at website price.</th><th>📅<br>Book / schedule</th><th>🔁<br>Reorders & shortages</th><th>📋<br>Subcontractor check<small>Understand your subcontractor’s estimated material cost</small></th><th>💬<br>Talk to your subs<small>Get material lists &amp; clarify shortages</small></th><th>😣 GC’s pain</th><th>✅ What this takes off your plate</th></tr></thead><tbody id=\"av-body\"></tbody></table></div>\n</div>\n<style>\n#avantia-checklist{--av-bg:light-dark(#ffffff,#17211f);--av-fg:light-dark(#173d33,#edf6f1);--av-line:light-dark(#d8e5df,#3a4b43);--av-soft:light-dark(#eff6f2,#22352b);--av-pain:light-dark(#fff3e5,#3b3024);--av-solve:light-dark(#eaf5ef,#233c2e);font-family:Arial,sans-serif;color:var(--av-fg);background:var(--av-bg);font-size:13px;line-height:1.45;width:100%;box-sizing:border-box}\n#avantia-checklist *{box-sizing:border-box}\n#avantia-checklist header{padding:16px;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;background:var(--av-soft)}\n#avantia-checklist .brand{letter-spacing:3px;font-size:13px;font-weight:600}\n#avantia-checklist h2{font-size:21px;margin:4px 0;font-weight:600}\n#avantia-checklist #av-save{font-size:12px;max-width:320px}\n#avantia-checklist .legend{padding:10px 16px;font-size:12px}\n#avantia-checklist .offer{padding:16px;background:var(--av-solve)}\n#avantia-checklist .offer strong{font-size:18px}\n#avantia-checklist .offer p{margin:8px 0}\n#avantia-checklist .benefits{display:flex;flex-wrap:wrap;gap:12px 24px}\n#avantia-checklist .fees td{background:var(--av-soft);border-top:2px solid var(--av-line)}\n#avantia-checklist .fees small{display:block;font-weight:400}\n#avantia-checklist .fees textarea{border:1px solid var(--av-line);background:var(--av-bg);min-height:80px;font-size:12px}\n@media print{#avantia-checklist .fees{display:none}}\n#avantia-checklist .sheet{width:100%;max-height:78dvh;overflow:auto;overscroll-behavior:contain;scroll-padding-top:100px}\n#avantia-checklist .sheet thead tr:first-child th{position:sticky;top:0;z-index:3}\n#avantia-checklist .sheet tbody td:first-child{position:sticky;left:0;background:var(--av-soft);z-index:2}\n#avantia-checklist .sheet thead tr:first-child th:first-child{left:0;z-index:4}\n#avantia-checklist .sheet th small{display:block;font-size:11px;font-weight:400;margin-top:5px}\n#avantia-checklist table{width:100%;min-width:1200px;border-collapse:separate;border-spacing:0;table-layout:fixed}\n#avantia-checklist th{padding:12px 5px;background:var(--av-soft);font-size:12px;font-weight:600;text-align:left;vertical-align:top;overflow-wrap:anywhere}\n#avantia-checklist td{padding:8px 5px;border-bottom:1px solid var(--av-line);vertical-align:top}\n#avantia-checklist td:nth-child(10),#avantia-checklist th:nth-child(10){background:var(--av-pain)}\n#avantia-checklist td:nth-child(11),#avantia-checklist th:nth-child(11){background:var(--av-solve)}\n#avantia-checklist textarea{font:inherit;color:inherit;background:transparent;border:1px solid transparent;border-radius:3px;width:100%;min-height:50px;display:block;resize:vertical;padding:4px;overflow:hidden}\n#avantia-checklist textarea:hover{border-color:var(--av-line)}\n#avantia-checklist textarea:focus{outline:2px solid light-dark(#288061,#83ceac);outline-offset:0;background:var(--av-bg)}\n#avantia-checklist td:first-child textarea{font-weight:600}\n#avantia-checklist .checklabel{display:flex;align-items:center;justify-content:center;min-height:44px;width:100%}\n#avantia-checklist input[type=checkbox]{width:20px;height:20px;accent-color:light-dark(#167253,#72cda7);margin:0}\n#avantia-checklist .option{display:flex;align-items:flex-start;gap:7px;padding:6px 0;overflow-wrap:anywhere}\n#avantia-checklist .option input{flex:0 0 20px}\n#avantia-checklist summary{padding:7px 0;font-weight:600}\n#avantia-checklist .reference{font-size:12px;margin-top:6px}\n#avantia-checklist .reference summary{font-weight:400}\n#avantia-checklist .picked div{padding:3px 0;overflow-wrap:anywhere}\n@media(pointer:coarse){#avantia-checklist textarea{font-size:16px}#avantia-checklist .option,#avantia-checklist summary{min-height:44px}}\n</style>\n<script>\n(()=>{\nconst root=document.getElementById('avantia-checklist'),body=root.querySelector('#av-body'),status=root.querySelector('#av-save');\nconst services=['Takeoff','Compare prices','Order at website price.','Book / schedule','Reorders & shortages','Subcontractor check','Talk to your subs'];\nwindow.plannerServices=row=>{const values=row.services.slice(0,6),pair=row.services.slice(5,7);values[5]=pair.includes(true)?true:pair.includes(null)?null:false;values.push(row.communicateWithSubs===true);return values;};\nconst outcomeSuggestions=[\"Get the copies you need without arranging each print run yourself.\", \"Keep site essentials organized without calling a different provider for each item.\", \"Request dumpster bookings and repeat supplies through the same contact.\", \"Keep survey appointments and report requests with one contact.\", \"Understand the material portion of your sub’s quote and which purchases are left to you.\", \"Your framer sends us the missing-material list. You do not have to relay it between the framer and lumberyard.\", \"Get the roofing package priced together, with accessories accounted for before ordering.\", \"Let us handle supplier questions so you only step in for the decisions that need your approval.\", \"Keep exterior material packages organized across suppliers and trades.\", \"Know what your trades include and get help sourcing the materials left to you.\", \"Get boards and installation supplies arranged together, including boom delivery when needed.\", \"Get the installer’s supporting materials together without shopping at several stores.\", \"Keep approved flooring quantities and installation supplies in one order plan.\", \"Keep measurements, doors and matching hardware together instead of managing separate purchases.\", \"Reorder the painter’s approved products without rebuilding the list each time.\", \"Compare the same appliance models across suppliers without making every call yourself.\", \"Arrange materials, concrete and pump bookings through one contact.\"];\nwindow.plannerOutcome=row=>row.outcome??outcomeSuggestions[row.id]??'';\nwindow.plannerRows=rows=>[...rows.filter(r=>r.id!==3),...rows.filter(r=>r.id===3)];\nlet rows=structuredClone(window.plannerInitial.state.rows);\nconst choices={pain:[['reorders','🔁 Frequent reorders'],['missing','📦 Missing materials / documents'],['pricing','💲 Overpaying / unclear pricing'],['calls','📞 Too many supplier calls'],['chasing','📅 Chasing bookings / deliveries'],['stores','🏪 Shopping at several stores'],['quantities','📐 Unclear quantities'],['scope','📋 Unclear subcontractor inclusions'],['approvals','⏳ Waiting for selections / approvals'],['other','✏️ Other']],solution:[['contact','📞 One supplier contact'],['reorders','🔁 Reorder through WhatsApp'],['compare','💲 Compare quotes / negotiate bulk pricing'],['takeoff','📐 Prepare takeoff for trade approval'],['scope','📋 Check what the subcontractor supplies'],['gaps','📦 Source materials the trade excludes'],['complete','🧰 Gather the installer’s complete supply list'],['order','🛒 Place approved orders'],['book','📅 Book services / appointments'],['confirm','✅ Chase confirmations / reports'],['approve','🤝 Handle supplier questions / approvals'],['other','✏️ Other']]};\n\n\nconst visibleChoices=key=>choices[key].filter(([id])=>key!=='solution'||!['contact','reorders','compare'].includes(id));\nlet fees=[...window.plannerInitial.state.fees],communicationFee=window.plannerInitial.state.communicationFee;\nconst feeHints=['e.g. $20 or $50 / takeoff','% of website price — define basis','Ordering fee / included','Fee per booking','Fee per reorder request','Fee per contract scope review','Fee for talking to subs'];\nlet timer,version=0,chain=Promise.resolve(),busy=false;\nfunction valid(s){return ['avantia-checklist-v4-pains-solutions','avantia-checklist-v5-fees'].includes(s?.modelContent?.type)&&Array.isArray(s.modelContent.rows)&&s.modelContent.rows.length===17&&s.modelContent.rows.every((r,i)=>r.id===i&&['department','items','pain','solution','painOther','solutionOther'].every(k=>typeof r[k]==='string')&&['pain','solution'].every(k=>Array.isArray(r[k+'Ids'])&&r[k+'Ids'].every(id=>choices[k].some(c=>c[0]===id)))&&Array.isArray(r.services)&&r.services.length===7&&r.services.every(v=>v===null||typeof v==='boolean'));}\nfunction restore(s){communicationFee=s.modelContent.communicationFee;rows=structuredClone(s.modelContent.rows);if(Array.isArray(s.modelContent.fees)&&s.modelContent.fees.length===7&&s.modelContent.fees.every(f=>typeof f==='string'))fees=[...s.modelContent.fees];}\nif(valid(window.openai?.widgetState))restore(window.openai.widgetState);\nfunction fit(t){t.style.height='auto';t.style.height=Math.max(50,t.scrollHeight+2)+'px';}\nfunction renderFees(){\nroot.querySelector('.fees')?.remove();const tr=document.createElement('tr');tr.className='fees';const label=document.createElement('td');label.colSpan=2;const title=document.createElement('strong');title.textContent='🔒 Internal fee planning';const note=document.createElement('small');note.textContent='Draft amounts · not customer prices · hidden when printing';label.append(title,note);tr.append(label);\nservices.forEach((service,i)=>{const td=document.createElement('td'),t=document.createElement('textarea');t.value=i===6?(communicationFee||''):(i===5?(fees[5]||fees[6]):fees[i]);t.placeholder=feeHints[i];t.maxLength=180;t.setAttribute('aria-label','Internal fee — '+service);t.addEventListener('input',()=>{if(i===6)communicationFee=t.value;else fees[i]=t.value;if(i===5)fees[6]='';fit(t);queue();});td.append(t);if(i===5&&fees[5]&&fees[6]&&fees[5]!==fees[6]){const earlier=document.createElement('small');earlier.textContent='Earlier material-cost fee: '+fees[6];td.append(earlier);}tr.append(td);});const tail=document.createElement('td');tail.colSpan=2;tail.textContent='Set a fee or percentage and its basis for each service. Blank = undecided.';tr.append(tail);root.querySelector('.sheet thead').append(tr);\n}\nfunction queue(){window.plannerDirty=true;const v=++version;status.textContent='Saving…';clearTimeout(timer);timer=setTimeout(()=>{const snapshot={modelContent:{type:'avantia-checklist-v5-fees',rows:structuredClone(rows),fees:[...fees],...(communicationFee===undefined?{}:{communicationFee})},privateContent:null};if(new TextEncoder().encode(JSON.stringify(snapshot)).length>15500){status.textContent='Text is too long to save; shorten a few entries.';return;}chain=chain.then(async()=>{if(!window.openai?.setWidgetState){status.textContent='Edited here; server saving unavailable.';return;}busy=true;try{await window.openai.setWidgetState(snapshot);if(version===v){status.textContent='Saved to Avantia';window.plannerDirty=false;}}catch{if(version===v)status.textContent='Not saved — edits remain in this view.';}finally{busy=false;}});},350);}\nfunction textcell(tr,row,key,label){const td=document.createElement('td'),t=document.createElement('textarea');t.value=row[key];t.rows=2;t.maxLength=450;t.setAttribute('aria-label',label+' — '+row.department);t.addEventListener('input',()=>{row[key]=t.value;fit(t);queue();});td.append(t);tr.append(td);}\nfunction choicecell(tr,row,key){\nconst td=document.createElement('td'),details=document.createElement('details'),summary=document.createElement('summary'),list=document.createElement('div'),picked=document.createElement('div'),reference=document.createElement('details'),refTitle=document.createElement('summary'),refText=document.createElement('textarea');\nsummary.className='cursor-interaction';summary.textContent=key==='pain'?'Choose pains':'Choose solutions';details.append(summary,list);list.className='choices';picked.className='picked';picked.setAttribute('aria-live','polite');\nfunction update(){picked.replaceChildren();visibleChoices(key).filter(c=>row[key+'Ids'].includes(c[0])).forEach(c=>{const line=document.createElement('div');line.textContent='✓ '+(c[0]==='other'?(row[key+'Other']||'Other'):c[1]);picked.append(line);});}\nlet otherBox;\nvisibleChoices(key).forEach(([id,name])=>{const label=document.createElement('label'),box=document.createElement('input'),text=document.createElement('span');label.className='option cursor-interaction';box.type='checkbox';box.checked=row[key+'Ids'].includes(id);box.setAttribute('aria-label',row.department+' — '+key+' — '+name);text.textContent=name;box.addEventListener('change',()=>{row[key+'Ids']=box.checked?[...new Set([...row[key+'Ids'],id])]:row[key+'Ids'].filter(v=>v!==id);update();queue();});if(id==='other')otherBox=box;label.append(box,text);list.append(label);});\nconst other=document.createElement('textarea');other.value=row[key+'Other'];other.placeholder='Your own wording…';other.maxLength=250;other.setAttribute('aria-label',row.department+' — custom '+key);other.addEventListener('input',()=>{row[key+'Other']=other.value;if(other.value.trim()&&!row[key+'Ids'].includes('other')){row[key+'Ids'].push('other');otherBox.checked=true;}fit(other);update();queue();});list.append(other);\nrefTitle.textContent='Earlier wording';refTitle.className='cursor-interaction';refText.value=row[key];refText.maxLength=450;refText.setAttribute('aria-label',row.department+' — earlier '+key);refText.addEventListener('input',()=>{row[key]=refText.value;fit(refText);queue();});reference.className='reference';reference.append(refTitle,refText);reference.addEventListener('toggle',()=>fit(refText));details.addEventListener('toggle',()=>fit(other));td.append(picked,details,reference);tr.append(td);update();\n}\nfunction outcomecell(tr,row){\nconst td=document.createElement('td'),text=document.createElement('textarea');text.value=window.plannerOutcome(row);text.maxLength=450;text.setAttribute('aria-label','What this takes off your plate — '+row.department);text.addEventListener('input',()=>{row.outcome=text.value;fit(text);queue();});td.append(text);\nconst previous=document.createElement('details'),title=document.createElement('summary'),wording=document.createElement('textarea'),picks=document.createElement('p');previous.className='reference';title.textContent='Earlier solution wording & selections';wording.value=row.solution;wording.maxLength=450;wording.setAttribute('aria-label',row.department+' — earlier solution');wording.addEventListener('input',()=>{row.solution=wording.value;fit(wording);queue();});picks.textContent=choices.solution.filter(([id])=>row.solutionIds.includes(id)).map(([id,label])=>id==='other'?row.solutionOther:label).join(' · ');previous.append(title,wording,picks);previous.addEventListener('toggle',()=>fit(wording));td.append(previous);tr.append(td);\n}\nfunction render(){renderFees();body.replaceChildren();window.plannerRows(rows).forEach(row=>{if(row.id===3){const section=document.createElement('tr'),heading=document.createElement('th');heading.colSpan=11;heading.scope='rowgroup';heading.textContent='Additional services / packages';section.append(heading);body.append(section);}const tr=document.createElement('tr');tr.dataset.rowId=row.id;textcell(tr,row,'department','Department');textcell(tr,row,'items','Items');window.plannerServices(row).forEach((v,j)=>{const td=document.createElement('td'),label=document.createElement('label'),input=document.createElement('input');label.className='checklabel cursor-interaction';input.type='checkbox';input.checked=v===true;input.indeterminate=v===null;input.setAttribute('aria-label',row.department+' — '+services[j]+(v===null?' — to confirm':''));input.addEventListener('change',()=>{if(j===6)row.communicateWithSubs=input.checked;else row.services[j]=input.checked;if(j===5)row.services[6]=input.checked;input.indeterminate=false;input.setAttribute('aria-label',row.department+' — '+services[j]);queue();});label.append(input);td.append(label);tr.append(td);});choicecell(tr,row,'pain');outcomecell(tr,row);body.append(tr);});requestAnimationFrame(()=>root.querySelectorAll('textarea').forEach(fit));}\nwindow.addEventListener('openai:set_globals',e=>{const s=e.detail?.globals?.widgetState;if(!busy&&version===0&&!root.contains(document.activeElement)&&valid(s)){restore(s);render();}});\nwindow.plannerSnapshot=()=>({type:'avantia-checklist-v5-fees',rows:structuredClone(rows),fees:[...fees],...(communicationFee===undefined?{}:{communicationFee})});\nwindow.plannerRestore=(state)=>{communicationFee=state.communicationFee;rows=structuredClone(state.rows);fees=[...state.fees];render();queue();};\nwindow.addEventListener('resize',()=>requestAnimationFrame(()=>root.querySelectorAll('textarea').forEach(fit)));\nrender();\n})();\n</script>\n"
